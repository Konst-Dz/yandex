APP_NAME="Yandex Reviews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Порт хоста = NGINX_HTTPS_PORT (см. ниже)
APP_URL=https://localhost:8443

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PostgreSQL (docker compose) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=yandex
DB_USERNAME=yandex
DB_PASSWORD=secret

# Совпадает с POSTGRES_* в docker/.env.example (учётные данные контейнера)
POSTGRES_USER=yandex
POSTGRES_PASSWORD=secret
POSTGRES_DB=yandex

# --- Очередь и кэш: PostgreSQL (database driver), Redis не используется ---
# Путь масштабирования: QUEUE_CONNECTION=redis + CACHE_STORE=redis и сервис redis в compose
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Сессии / Sanctum SPA (cookie-based) ---
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8443

FILESYSTEM_DISK=local

# --- Docker compose ---
# uid/gid вашего пользователя на хосте (Linux): id -u / id -g
USER_ID=1000
GROUP_ID=1000

# Порты nginx на хосте — 80/443 заняты другим локальным проектом
NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=8443
