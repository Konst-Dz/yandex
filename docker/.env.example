# Переменные docker compose (скопируйте в корневой .env — compose читает его автоматически)

# uid/gid вашего пользователя на хосте (Linux): id -u / id -g — для прав на bind-mount
USER_ID=1000
GROUP_ID=1000

# Порты nginx на хосте. Нельзя 80/443 — там уже висит techstore, 8080 — reverb poradnia
NGINX_HTTP_PORT=8082
NGINX_HTTPS_PORT=8443

# PostgreSQL — значения контейнера; DB_* для Laravel должны совпадать (см. .env.example)
POSTGRES_USER=yandex
POSTGRES_PASSWORD=secret
POSTGRES_DB=yandex
